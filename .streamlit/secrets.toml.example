# Salin file ini menjadi `secrets.toml` (di folder .streamlit/) untuk deployment
# Anda sendiri. File ini di-gitignore, jadi aman dari commit.
#
# Aplikasi ini punya dua peran:
# - Admin: login pakai ADMIN_PASSWORD, lalu isi/ubah Invezgo API Key lewat
#   panel di halaman Home. Key itu disimpan persisten (lihat utils/key_store.py)
#   dan dipakai bersama oleh semua pengguna.
# - User biasa: pakai aplikasi seperti biasa, tidak pernah melihat/mengisi API Key.

# WAJIB agar panel Admin bisa dipakai sama sekali.
ADMIN_PASSWORD = "ganti-dengan-password-admin-yang-kuat"

# SANGAT DISARANKAN: kunci untuk mengenkripsi API Key yang disimpan Admin lewat
# panel (bebas string apa saja, semakin acak semakin baik). Tanpa ini, key
# tetap tersimpan tapi hanya di-obfuscate (base64), bukan dienkripsi.
APP_SECRET_KEY = "ganti-dengan-string-acak-panjang"

# OPSIONAL tapi disarankan: cadangan permanen. Kalau Admin mengisi key lewat
# panel di aplikasi, key itu tersimpan di berkas lokal yang bertahan lintas
# sesi TAPI hilang saat aplikasi di-redeploy (Streamlit Cloud clone ulang repo
# setiap deploy). Isi INVEZGO_API_KEY di sini juga supaya aplikasi tetap
# berfungsi walau berkas lokal itu hilang — key dari panel Admin selalu dipakai
# duluan kalau ada, ini cuma jaring pengaman.
INVEZGO_API_KEY = "isi-api-key-anda-di-sini"
