# Salin file ini menjadi `secrets.toml` (di folder .streamlit/) HANYA jika Anda
# men-deploy versi pribadi dan ingin API key otomatis terisi tanpa harus
# mengetik ulang setiap sesi. File ini di-gitignore, jadi aman dari commit.
#
# Kalau tidak diisi, Anda tetap bisa memakai app dengan mengetik API Key
# langsung di sidebar aplikasi (tidak pernah disimpan ke kode/repo).

INVEZGO_API_KEY = "isi-api-key-anda-di-sini"
