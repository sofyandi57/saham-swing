# Salin file ini menjadi `secrets.toml` (di folder .streamlit/) untuk deployment
# Anda sendiri. File ini di-gitignore, jadi aman dari commit.
#
# Login (username/password) tidak diatur lewat secrets — akun tersimpan
# terenkripsi-hash di .data/users.json (lihat utils/user_store.py), dibuat
# otomatis dengan admin default saat pertama kali dijalankan:
#   Username: sofyandisedar
#   Password: Saya1234!
# Segera login dan ganti password default itu lewat sidebar ("Ganti Password
# Saya"), dan buat akun User lain lewat panel Admin di halaman Home.

# SANGAT DISARANKAN: kunci untuk mengenkripsi Invezgo API Key yang disimpan
# Admin lewat panel (bebas string apa saja, semakin acak semakin baik). Tanpa
# ini, key tetap tersimpan tapi hanya di-obfuscate (base64), bukan dienkripsi.
APP_SECRET_KEY = "ganti-dengan-string-acak-panjang"

# OPSIONAL tapi disarankan: cadangan permanen. Kalau Admin mengisi API Key
# lewat panel di aplikasi, key itu tersimpan di berkas lokal yang bertahan
# lintas sesi TAPI hilang saat aplikasi di-redeploy (Streamlit Cloud clone
# ulang repo setiap deploy). Isi INVEZGO_API_KEY di sini juga supaya aplikasi
# tetap berfungsi walau berkas lokal itu hilang — key dari panel Admin selalu
# dipakai duluan kalau ada, ini cuma jaring pengaman.
INVEZGO_API_KEY = "isi-api-key-anda-di-sini"
